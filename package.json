{
  "name": "household-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Household OS — home maintenance and shared to-dos for two, built around an interactive isometric house. Installable PWA.",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env --tsconfig tsconfig.node.json --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server/index.js",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.sw.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "vapid": "node scripts/generate-vapid.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/foundry-sdk": "^1.0.0",
    "@anthropic-ai/sdk": "^1.1.0",
    "@hono/node-server": "^1.19.17",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.13",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.43.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
