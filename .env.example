# ── Core ─────────────────────────────────────────────────────────────────────────────────────
# PORT=8787                          # Cloud Run sets 8080 automatically
# DATABASE_PATH=data/household.db
# APP_ORIGIN=https://home.example.com  # optional; used for invite links and the CSRF check
# MAX_MEMBERS=3

# ── Push notifications (Web Push) ────────────────────────────────────────────────────────────
# Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Scheduled reminders ──────────────────────────────────────────────────────────────────────
# Shared secret for POST /api/cron/reminders (sent as the X-Cron-Secret header).
CRON_SECRET=
# Run reminders in-process every N minutes instead (VMs, docker-compose). 0 = rely on the cron.
# REMINDER_INTERVAL_MINUTES=5

# ── Durable storage on Cloud Run (SQLite snapshots in Cloud Storage) ─────────────────────────
# GCS_BUCKET=my-project-household-os
# GCS_OBJECT=household.db

# ── AI on Azure (optional) ───────────────────────────────────────────────────────────────────
# Claude on Microsoft Foundry (default when ANTHROPIC_FOUNDRY_API_KEY is set):
# AI_PROVIDER=foundry
# ANTHROPIC_FOUNDRY_API_KEY=
# ANTHROPIC_FOUNDRY_RESOURCE=my-foundry-resource   # → https://my-foundry-resource.services.ai.azure.com/anthropic/
# AI_MODEL=claude-opus-5-5                          # your Foundry deployment name
# AI_FALLBACK_MODEL=                                # optional second deployment, used if a request is declined
#
# Or Azure OpenAI:
# AI_PROVIDER=azure-openai
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
